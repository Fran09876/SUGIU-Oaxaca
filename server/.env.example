# ========================================================
# SIGIU - Variables de Entorno del Backend (Server)
# Municipio de Oaxaca de Juárez
# ========================================================

# Puerto del servidor (Render lo asigna en automático)
PORT=5000

# Entorno: development | production | test
NODE_ENV=production

# --------------------------------------------------------
# Opción 1: Conexión mediante DATABASE_URL (Recomendado para Neon / Supabase / Render)
# --------------------------------------------------------
DATABASE_URL=postgresql://neondb_owner:tu_password@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require

# --------------------------------------------------------
# Opción 2: Parámetros individuales (Desarrollo local en PostgreSQL)
# --------------------------------------------------------
USE_SQLITE=false
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sigiu_db
DB_USER=postgres
DB_PASSWORD=tu_password_local
DB_SSL=false

# --------------------------------------------------------
# Seguridad y Autenticación JWT Stateless
# --------------------------------------------------------
JWT_SECRET=sigiu_oaxaca_jwt_super_secret_key_2026_secure
JWT_EXPIRES_IN=7d

# --------------------------------------------------------
# Control de Acceso CORS (URL de tu Frontend en Vercel)
# --------------------------------------------------------
CLIENT_URL=https://sugiu-oaxaca.vercel.app

# --------------------------------------------------------
# Almacenamiento de Evidencias Fotográficas
# --------------------------------------------------------
UPLOAD_DIR=uploads
